# ─── RAG / LLM ───────────────────────────────────────────────────────
# 'anthropic' | 'ollama' | 'extractive' (default, no LLM needed)
LLM_PROVIDER=extractive

# Anthropic (required if LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-5

# Ollama (required if LLM_PROVIDER=ollama)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ─── Embeddings ──────────────────────────────────────────────────────
# 'local' (default, free, runs in Node) | 'hosted'
EMBEDDINGS_PROVIDER=local
EMBEDDINGS_MODEL=Xenova/multilingual-e5-small

# Required if EMBEDDINGS_PROVIDER=hosted
EMBEDDINGS_API_URL=
EMBEDDINGS_API_KEY=

# ─── Retrieval tuning ────────────────────────────────────────────────
# Minimum fused score to attempt LLM generation (0-1)
RAG_RELEVANCE_THRESHOLD=0.25

# ─── Client mode ─────────────────────────────────────────────────────
# 'live' = call /api/ask; anything else = DEMO_SCRIPTED
NEXT_PUBLIC_ASK_MODE=demo

# ─── Public site URL (for QR codes in kiosk/display) ─────────────────
NEXT_PUBLIC_SITE_URL=

# ─── Database (optional — stub for future pgvector upgrade) ──────────
# DATABASE_URL=postgresql://...
